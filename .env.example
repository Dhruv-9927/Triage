# ============================================
# Triage+ (SeHAT) - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sehat_user:sehat_dev_password@localhost:5432/sehat_db
DATABASE_URL_SYNC=postgresql://sehat_user:sehat_dev_password@localhost:5432/sehat_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# --- AI / LLM ---
# Use either OpenAI or Anthropic (set the one you have)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
LLM_PROVIDER=openai
# Options: openai, anthropic
LLM_MODEL=gpt-4o-mini
# For OpenAI: gpt-4o-mini, gpt-4o
# For Anthropic: claude-3-5-sonnet-20241022

# --- Translation ---
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_USER_ID=your-bhashini-user-id
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
TRANSLATION_PROVIDER=google
# Options: bhashini, google, mock

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_NAME=SeHAT - Smart e-Health Access & Triage
APP_VERSION=1.0.0
DEBUG=true
